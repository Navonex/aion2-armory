# Adresse, unter der die Armory erreichbar ist (für Teilen-Links). Ohne Domain z. B.:
ARMORY_BASE_URL=http://localhost:8000

# Passwort für die Gilde (Benutzername beim Abfragen egal). Leer = jeder mit der Adresse kommt rein.
# Geteilte Links (/v/…) funktionieren immer ohne Passwort.
ARMORY_PASSWORT=

# Nur nötig, wenn die Armory öffentlich im Internet steht (Impressum/Datenschutz).
# Anschrift: Zeilen mit ; trennen.
ARMORY_OPERATOR_NAME=
ARMORY_OPERATOR_ADDRESS=
ARMORY_OPERATOR_EMAIL=
ARMORY_HOSTER=
